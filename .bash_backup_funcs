backup() {
  BACKUP_DEVICE='/dev/sdb1'
  MOUNT_LINE=$(cat /proc/mounts | grep $BACKUP_DEVICE)
  if [ -n "$MOUNT_LINE" ]; then
    MOUNT_POINT=$(echo "$MOUNT_LINE" | awk '{print $2}')
    BACKUP_ROOT="$MOUNT_POINT/backup/$HOME"
    DEST="$BACKUP_ROOT/$(date +%Y-%m-%d-%H%M)"
    LATEST="$BACKUP_ROOT/latest"

    echo "Backing up $HOME to $DEST"
    mkdir -p "$DEST"

    # Find previous backup for --link-dest (hard-link incremental)
    PREV=$(ls -dt "$BACKUP_ROOT"/*/ 2>/dev/null | head -1)

    # Load exclude patterns from ~/.backupignore (one pattern per line, # comments)
    EXCLUDE_FILE="$HOME/.backupignore"
    if [ -f "$EXCLUDE_FILE" ]; then
      mapfile -t EXCLUDE_PATTERNS < <(grep -v '^#' "$EXCLUDE_FILE" | grep -v '^$')
    else
      EXCLUDE_PATTERNS=()
    fi

    RSYNC_OPTS=(
      -az
      --delete                    # delete files from dest that were removed from source
      --delete-excluded           # also delete excluded files from dest
      --partial                   # keep partial transfers for resume
      --inplace                   # write files in-place (faster for large files, enables resume)
      --info=progress2            # show overall progress bar
      --human-readable            # human-readable sizes
      --exclude='node_modules/'   # JS/TS dependencies
      --exclude='.git/'           # git repos (backup .git/config separately if needed)
      --exclude='*.pyc'           # Python bytecode
      --exclude='__pycache__/'    # Python cache
      --exclude='.cache/'         # generic caches
      --exclude='Cache/'          # macOS/Chrome caches
      --exclude='.npm/'           # npm cache
      --exclude='.yarn/'          # yarn cache
      --exclude='.pnpm-store/'    # pnpm store
      --exclude='.gradle/'        # Gradle cache
      --exclude='.m2/'            # Maven cache
      --exclude='.cargo/'         # Cargo cache (keep src, exclude registry/git)
      --exclude='target/'         # Rust/Cargo build artifacts
      --exclude='dist/'           # build outputs
      --exclude='build/'          # build outputs
      --exclude='.next/'          # Next.js build
      --exclude='.vercel/'        # Vercel build
      --exclude='.turbo/'         # Turborepo cache
      --exclude='.parcel-cache/'  # Parcel cache
      --exclude='*.log'           # log files
      --exclude='*.tmp'           # temp files
      --exclude='*.swp'           # vim swap
      --exclude='*~'              # backup files
      --exclude='.DS_Store'       # macOS metadata
      --exclude='Thumbs.db'       # Windows metadata
      --exclude='lost+found/'     # filesystem recovery
      --exclude='.Trash-*/'       # Linux trash
      --exclude='.local/share/Trash/' # user trash
      --exclude='.steam/'         # Steam games
      --exclude='SteamLibrary/'   # Steam library
      --exclude='VirtualBox VMs/' # VM images (huge)
      --exclude='*.vdi'           # VirtualBox disk images
      --exclude='*.vmdk'          # VMware disk images
      --exclude='*.qcow2'         # QEMU disk images
      --exclude='*.iso'           # ISO images
      --exclude='*.img'           # disk images
    )

    # Add patterns from ~/.backupignore
    for pattern in "${EXCLUDE_PATTERNS[@]}"; do
      RSYNC_OPTS+=(--exclude="$pattern")
    done

    if [ -n "$PREV" ] && [ "$PREV" != "$DEST/" ]; then
      RSYNC_OPTS+=(--link-dest="$PREV")
      echo "Linking unchanged files from previous backup: $PREV"
    fi

    rsync "${RSYNC_OPTS[@]}" "$HOME/" "$DEST/"

    # Update 'latest' symlink
    ln -sfn "$DEST" "$LATEST"
    echo "Backup complete. Latest symlink: $LATEST -> $DEST"
  else
    echo "Error: ${BACKUP_DEVICE} is not mounted."
    return 1
  fi
}
